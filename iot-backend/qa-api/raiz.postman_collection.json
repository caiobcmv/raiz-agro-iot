{
  "info": {
    "name": "Raiz API - Suite QA Completa (Atualizada)",
    "description": "Cobertura completa da API Raiz: Saúde, Autenticação 3 perfis, RBAC/Escopo, Sensores/Topologia, Dashboard Stream, Central de Alertas, Previsões, IA e Auditoria.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Saúde e Segurança Básica (401)",
      "item": [
        {
          "name": "GET / - Healthcheck da API",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Retorna status ok e docs', () => {",
            "    const j = pm.response.json();",
            "    pm.expect(j.status).to.eql('ok');",
            "    pm.expect(j.docs).to.eql('/docs');",
            "});",
            "pm.test('Latência < 1000ms', () => pm.expect(pm.response.responseTime).to.be.below(1000));"
          ]}}],
          "request": { "method": "GET", "url": "{{base_url}}/" }
        },
        {
          "name": "GET /usuarios - Sem Token (401)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Bloqueia acesso anônimo (401)', () => pm.response.to.have.status(401));"
          ]}}],
          "request": { "method": "GET", "url": "{{base_url}}/usuarios" }
        },
        {
          "name": "GET /central-alertas - Sem Token (401)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Central de alertas exige autenticação (401)', () => pm.response.to.have.status(401));"
          ]}}],
          "request": { "method": "GET", "url": "{{base_url}}/central-alertas" }
        }
      ]
    },
    {
      "name": "2. Autenticação dos 3 Perfis",
      "item": [
        {
          "name": "POST /auth/login - Payload Vazio (422)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Rejeita entrada inválida (422)', () => pm.response.to.have.status(422));"
          ]}}],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{}" }, "url": "{{base_url}}/auth/login" }
        },
        {
          "name": "POST /auth/login - Senha Errada (401)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Recusa credenciais inválidas (401)', () => pm.response.to.have.status(401));",
            "pm.test('Resposta genérica anti-enumeração', () => pm.expect(pm.response.json().detail).to.eql('Credenciais inválidas'));"
          ]}}],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\": \"naoexiste@raiz.com\", \"senha\": \"errada123\"}" }, "url": "{{base_url}}/auth/login" }
        },
        {
          "name": "POST /auth/login - Administrador",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Login Admin 200 OK', () => pm.response.to.have.status(200));",
            "const j = pm.response.json();",
            "pm.test('Token JWT retornado', () => pm.expect(j.access_token).to.be.a('string'));",
            "pm.environment.set('token_admin', j.access_token);"
          ]}}],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\": \"{{admin_email}}\", \"senha\": \"{{admin_senha}}\"}" }, "url": "{{base_url}}/auth/login" }
        },
        {
          "name": "POST /auth/login - Analista de Dados",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Login Analista 200 OK', () => pm.response.to.have.status(200));",
            "const j = pm.response.json();",
            "pm.test('Token JWT retornado', () => pm.expect(j.access_token).to.be.a('string'));",
            "pm.environment.set('token_analista', j.access_token);"
          ]}}],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\": \"{{analista_email}}\", \"senha\": \"{{analista_senha}}\"}" }, "url": "{{base_url}}/auth/login" }
        },
        {
          "name": "POST /auth/login - Produtor/Exportador",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Login Produtor 200 OK', () => pm.response.to.have.status(200));",
            "const j = pm.response.json();",
            "pm.test('Token JWT retornado', () => pm.expect(j.access_token).to.be.a('string'));",
            "pm.environment.set('token_produtor', j.access_token);"
          ]}}],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\": \"{{prod_email}}\", \"senha\": \"{{prod_senha}}\"}" }, "url": "{{base_url}}/auth/login" }
        },
        {
          "name": "GET /auth/me - Sessão Admin",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
            "const u = pm.response.json();",
            "pm.test('Estrutura do usuário completa', () => pm.expect(u).to.include.keys('id_usuario', 'nome', 'email', 'perfil'));",
            "pm.test('Perfil é Administrador', () => pm.expect(u.perfil).to.eql('Administrador'));"
          ]}}],
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }], "url": "{{base_url}}/auth/me" }
        }
      ]
    },
